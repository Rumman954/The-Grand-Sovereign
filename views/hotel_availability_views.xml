<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_availability_form" model="ir.ui.view">
        <field name="name">hotel.availability.form</field>
        <field name="model">hotel.availability</field>
        <field name="arch" type="xml">
            <form string="Room Availability">
                <sheet>
                    <div class="oe_title">
                        <h1>Room Availability</h1>
                    </div>
                    <group>
                        <group>
                            <field name="check_in"/>
                            <field name="check_out"/>
                        </group>
                        <group>
                            <field name="room_count" string="Free Rooms"/>
                            <field name="single_count"/>
                            <field name="double_count"/>
                            <field name="deluxe_count"/>
                            <field name="suite_count"/>
                        </group>
                    </group>
                    <field name="room_ids" readonly="1">
                        <list create="false" delete="false" edit="false" limit="80">
                            <field name="number"/>
                            <field name="room_type"/>
                            <field name="floor"/>
                            <field name="capacity"/>
                            <field name="price_per_night"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hotel_availability" model="ir.actions.act_window">
        <field name="name">Availability</field>
        <field name="res_model">hotel.availability</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
